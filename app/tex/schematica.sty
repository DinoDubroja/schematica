\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{schematica}[2026/11/13 Schematica rendering proof]
\RequirePackage{circuitikz}
\newif\ifSCsvg
\SCsvgfalse
% Enable only for a dvisvgm driver document. Native PDF/CircuitikZ uses false.
\newcommand{\SCsvgtrueexport}{\SCsvgtrue}
\newwrite\SCmetadata
\newif\ifSCrecord
\SCrecordfalse
\newcommand{\SCrecordto}[1]{\immediate\openout\SCmetadata=#1\relax\SCrecordtrue}
\newcommand{\SCrecordend}{\ifSCrecord\immediate\closeout\SCmetadata\fi\SCrecordfalse}
\newcommand{\SCemit}[1]{\ifSCrecord\immediate\write\SCmetadata{#1}\fi}
\newcommand{\SCresolve}[3]{%
  \def\SCinstance{#1}%
  \pgfmathsetmacro{\SCscale}{#2*5/3}%
  \def\SCstroke{#3}%
  \SCemit{instance|#1|#2|#3}%
}
\newcommand{\SCpin}[3]{%
  \pgfmathsetmacro{\SCpx}{#2}\pgfmathsetmacro{\SCpy}{#3}%
  \coordinate (\SCinstance-#1) at (\SCpx,\SCpy);
  \SCemit{pin|#1|\SCpx|\SCpy}%
}
\newcommand{\SCdimension}[2]{%
  \pgfmathsetmacro{\SCvalue}{#2}\SCemit{dimension|#1|\SCvalue}%
}
\newenvironment{SCpart}[1]{%
  \SCemit{part|#1}%
  \ifSCsvg\special{dvisvgm:raw <g id="\SCinstance--#1" data-part="#1">}\fi
}{\ifSCsvg\special{dvisvgm:raw </g>}\fi}
